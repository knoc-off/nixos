diff --git a/src/player/PlayerComponent.cpp b/src/player/PlayerComponent.cpp
index b53e684..05dded4 100644
--- a/src/player/PlayerComponent.cpp
+++ b/src/player/PlayerComponent.cpp
@@ -1490,6 +1490,16 @@ void PlayerComponent::setOtherConfiguration()
     {
       QString configurationKey = configuration.left(splitIndex).remove(QRegularExpression("^([\"]+)")).remove(QRegularExpression("([\"]+)$"));
       QString configurationValue = configuration.right(configurationLength - splitIndex - 1).remove(QRegularExpression("^([\"]+)")).remove(QRegularExpression("([\"]+)$"));
+      if (configurationKey == "load-script")
+      {
+        // "scripts" is only read at mpv_initialize, which already happened.
+        if (!m_loadedScripts.contains(configurationValue))
+        {
+          m_loadedScripts << configurationValue;
+          m_mpv->command(QStringList() << "load-script" << configurationValue);
+        }
+        continue;
+      }
       m_mpv->setProperty( configurationKey, configurationValue);
     }
   }
