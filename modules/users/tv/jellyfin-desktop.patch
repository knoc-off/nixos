+/////////////////////////////////////////////////////////////////////////////////////////
+void PlayerComponent::playExternal(const QString& url, qint64 startMs, int audioIndex, const QVariant& subtitle)
+{
+  // The script reports where playback ended on stdout; mpv's own exit code
+  // cannot tell "quit at 12:34" from "reached the end".
+  static const char* report =
+    "local p, eof = 0, false\n"
+    "mp.observe_property('time-pos', 'number', function(_, v) if v then p = v end end)\n"
+    "mp.register_event('end-file', function(e) eof = e.reason == 'eof' end)\n"
+    "mp.register_event('shutdown', function() io.stdout:write(string.format('JMP_EXTERNAL %d %d\\n', math.floor(p * 1000), eof and 1 or 0)); io.stdout:flush() end)\n";
+
+  auto* script = new QTemporaryFile(QDir::tempPath() + "/jmp-external-XXXXXX.lua", this);
+  script->open();
+  script->write(report);
+  script->flush();
+
+  QStringList args = {
+    "--fullscreen",
+    "--force-window=immediate",
+    "--keep-open=no",
+    "--idle=no",
+    "--save-position-on-quit=no",
+    // Jellyfin owns the resume point; a stale watch_later entry for the same
+    // URL must not override --start.
+    "--resume-playback=no",
+    // Lets the box (and tests) stop it cleanly; quit still runs the shutdown
+    // hook that reports the position.
+    "--input-ipc-server=" + QDir::tempPath() + "/jmp-external-mpv.sock",
+    "--script=" + script->fileName(),
+    "--start=" + QString::number(startMs / 1000.0, 'f', 3),
+  };
+  if (audioIndex > 0)
+    args << "--aid=" + QString::number(audioIndex);
+  if (subtitle.typeId() == QMetaType::QString && subtitle.toString().startsWith("#,"))
+    args << "--sub-file=" + subtitle.toString().mid(2);
+  else if (subtitle.toInt() > 0)
+    args << "--sid=" + QString::number(subtitle.toInt());
+  else
+    args << "--sid=no";
+  args << "--" << url;
+
+  auto* proc = new QProcess(this);
+  proc->setProcessChannelMode(QProcess::ForwardedErrorChannel);
+  connect(proc, &QProcess::finished, this, [this, proc, script](int, QProcess::ExitStatus)
+  {
+    qint64 pos = -1;
+    bool eof = false;
+    for (const QString& line : QString::fromUtf8(proc->readAllStandardOutput()).split('\n'))
+    {
+      if (line.startsWith("JMP_EXTERNAL "))
+      {
+        QStringList f = line.split(' ');
+        pos = f.value(1).toLongLong();
+        eof = f.value(2) == "1";
+      }
+    }
+    qInfo() << "External player exited at" << pos << "ms, eof:" << eof;
+    proc->deleteLater();
+    script->deleteLater();
+    emit externalFinished(pos, eof);
+  });
+
+  qInfo() << "Starting external player for" << url;
+  proc->start("mpv", args);
+}
